# Copy to backend/.env (gitignored) and fill in. Process environment variables take precedence.
# Empty values are treated as unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional (temporary credentials only); leave empty for long-term keys.
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
# Empty -> fake LLM. Haiku 4.5 by default, Sonnet 4.6 for question_generation.
LLM_CONFIG={"provider":"bedrock","region":"ap-northeast-2"}
# 우리말샘 open API key (optional; without it, hanja missing from the DB are answered "잘 모르겠어요").
OPENDICT_API_KEY=
# Optional storage: external PostgreSQL URL, or a directory for the embedded server (e.g. .pgdata).
# Both empty -> in-memory conversation store.
DATABASE_URL=
PG_EMBEDDED_DIR=
